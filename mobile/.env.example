# The server the app talks to, read when Metro bundles (restart `expo start` after changing it).
#
# Real phone on the same Wi-Fi as this machine, local server: http://<this machine's LAN IP>:3009
#   (find it with: ip -4 addr | grep inet). Dev builds allow plain http; release builds need https.
# Android emulator: http://10.0.2.2:3009
# Never point a development build at production: counts approved there change real stock.
EXPO_PUBLIC_API_URL=http://192.168.1.96:3009
