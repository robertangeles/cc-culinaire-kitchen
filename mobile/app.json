{
  "expo": {
    "name": "CulinAIre Kitchen",
    "slug": "culinaire-kitchen",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.culinairekitchen.chef",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.culinairekitchen.chef",
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "culinaire",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#A26A38"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CulinAIre Kitchen uses your photos when you choose a profile picture or a photo of a certificate.",
          "cameraPermission": "CulinAIre Kitchen uses the camera when you take a profile picture or a photo of a certificate.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CulinAIre Kitchen uses Face ID to unlock the app and to confirm approvals."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3EFE4",
          "dark": {
            "backgroundColor": "#101418"
          }
        }
      ]
    ]
  }
}
