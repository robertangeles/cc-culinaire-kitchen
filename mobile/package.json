{
  "name": "@culinaire/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:test": "vitest run",
    "check:test:logic": "vitest run src",
    "check:bundle": "expo export --platform android --output-dir dist-check",
    "check:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:device": "bash device/lease.sh vitest run --config vitest.device.config.ts"
  },
  "dependencies": {
    "@culinaire/shared": "workspace:*",
    "@expo-google-fonts/fraunces": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@react-native-google-signin/google-signin": "16.1.2",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.3.0",
    "dotenv": "^16.6.1",
    "jsdom": "^28.1.0",
    "otplib": "^13.3.0",
    "react-native-web": "~0.21.4",
    "typescript": "~6.0.3",
    "vitest": "^3"
  }
}
